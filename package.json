{
  "name": "@tryatlas/design",
  "version": "0.1.18",
  "private": false,
  "description": "Atlas's design system: primitives, tokens, themes and the ratchet, shared by desktop, web and docs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryatlas/design.git"
  },
  "files": [
    "dist",
    "src/styles",
    "keys.toml",
    "themes",
    "theme-rules",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./variants": {
      "types": "./dist/variants.d.ts",
      "import": "./dist/variants.js"
    },
    "./blocks": {
      "types": "./dist/components/blocks/index.d.ts",
      "import": "./dist/components/blocks/index.js"
    },
    "./styles.css": "./src/styles/styles.css",
    "./styles-core.css": "./src/styles/styles-core.css",
    "./blocks.css": "./src/styles/blocks.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./timeline-calendar": {
      "types": "./dist/components/blocks/timeline-calendar.d.ts",
      "import": "./dist/components/blocks/timeline-calendar.js"
    },
    "./checkpoint-trace": {
      "types": "./dist/components/blocks/checkpoint-trace.d.ts",
      "import": "./dist/components/blocks/checkpoint-trace.js"
    },
    "./animations": {
      "types": "./dist/lib/infinite-animations.d.ts",
      "import": "./dist/lib/infinite-animations.js"
    },
    "./ratchet": {
      "types": "./dist/ratchet/index.d.ts",
      "import": "./dist/ratchet/index.js"
    },
    "./keys.toml": "./keys.toml",
    "./themes/*": "./themes/*",
    "./theme-rules/*": "./theme-rules/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "theme": "bun scripts/generate-theme.ts",
    "theme:check": "bun scripts/generate-theme.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:consumer": "bun run build && bun pm pack --quiet --filename fixtures/consumer/design.tgz && cd fixtures/consumer && rm -rf node_modules bun.lock && bun install && bun run check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "storybook:smoke": "bun scripts/storybook-smoke.ts",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cobe": "^2.0.1",
    "react-resizable-panels": "^4.15.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-virtual": "^3.14.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "oxfmt": "^0.75.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.9.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.0",
    "lucide-react": "^1.48.0",
    "motion": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-parse": {
      "optional": true
    },
    "unified": {
      "optional": true
    }
  }
}
